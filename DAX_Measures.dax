Total Employees = COUNTROWS(HR_Employees)

Attrition Count =
CALCULATE(COUNTROWS(HR_Employees), HR_Employees[Attrition] = "Yes")

Attrition Rate =
DIVIDE([Attrition Count], [Total Employees], 0)

Active Employees =
CALCULATE(COUNTROWS(HR_Employees), HR_Employees[Attrition] = "No")

Average Monthly Income = AVERAGE(HR_Employees[MonthlyIncome])

Average Age = AVERAGE(HR_Employees[Age])

Average Tenure = AVERAGE(HR_Employees[YearsAtCompany])

Overtime Employees =
CALCULATE(COUNTROWS(HR_Employees), HR_Employees[OverTime] = "Yes")

Overtime Attrition Rate =
CALCULATE([Attrition Rate], HR_Employees[OverTime] = "Yes")

Department Attrition Rate = [Attrition Rate]
